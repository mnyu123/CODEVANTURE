# Local setup and health checks work without any values.
# Copy to .env when external integration begins. Never commit .env.

# Browser-visible Supabase values; never put a secret/service-role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only values for Netlify Functions. Never prefix these with VITE_.
GEMINI_API_KEY=
# Choose and verify an available model when AI integration begins.
GEMINI_MODEL=
